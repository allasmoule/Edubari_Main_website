# ---------------------------------------------------------------------------
# PostgreSQL (the app, migrations and scripts all use these)
# ---------------------------------------------------------------------------
# Either one connection URL ...
#   DATABASE_URL=postgres://edubari:password@localhost:5432/edubari
# ... or the standard PostgreSQL variables. docker-compose uses these to create the database
# container and points the app at it (PGHOST=db is set there automatically).
PGHOST=localhost
PGPORT=5432
PGUSER=edubari
PGPASSWORD=change-me-long-random-password
PGDATABASE=edubari
# require / verify-full for a managed database over the internet; disable for local Docker
PGSSLMODE=disable
# Optional tuning
# DB_POOL_MAX=10
# DB_STATEMENT_TIMEOUT_MS=15000

# First admin, used once by `npm run db:seed` on an empty database (12+ characters).
# Remove them from .env afterwards; later resets: `npm run admin:reset -- --email you@example.com`
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# One-time import from the old MySQL database (npm run db:import-mysql)
# Delete this block once the import is done and verified.
# ---------------------------------------------------------------------------
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=edubari
# Time zone the old app wrote dates in: Z (UTC, the old Docker default) or +06:00 (Bangladesh)
# MYSQL_TIMEZONE=Z

# ---------------------------------------------------------------------------
# Authentication & security
# ---------------------------------------------------------------------------
# Admin login cookie signing key (48+ random characters, e.g. `openssl rand -hex 32`)
ADMIN_SESSION_SECRET=
# Fallback signing key; ignored when ADMIN_SESSION_SECRET is set
JWT_SECRET=
# Reverse proxies in front of the app (nginx = 1). The client IP for the login limit is read
# this many entries from the right of X-Forwarded-For, so a forged header cannot bypass it.
TRUSTED_PROXY_COUNT=1

# ---------------------------------------------------------------------------
# Public app settings
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_IMGBB_API_KEY=
# GOOGLE_SHEET_WEBAPP_URL=

# ---------------------------------------------------------------------------
# Email notifications (orders, contact messages, payments)
# ---------------------------------------------------------------------------
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_APP_PASS=
EMAIL_TO=
EMAIL_CC=

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
# Where bKash / Nagad send the customer back after paying (this website's public URL)
PAYMENT_CALLBACK_BASE_URL=https://edubari.bd

# Extra hosts a customer may be redirected back to after payment (comma separated)
ALLOWED_REDIRECT_HOSTS=

# bKash Tokenized Checkout (merchant credentials from bKash)
BKASH_MODE=sandbox
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# Nagad Merchant Checkout (keys from Nagad; PEM or bare base64)
NAGAD_MODE=sandbox
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
NAGAD_PG_PUBLIC_KEY=
NAGAD_MERCHANT_PRIVATE_KEY=

# AI credit gateway webhook (X-Edubari-Signature = HMAC-SHA256 of the body; 32+ characters)
AI_GATEWAY_WEBHOOK_SECRET=
# STRIPE_SECRET_KEY=
